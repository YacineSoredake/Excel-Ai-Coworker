# --- worker (server only, NEVER expose to the browser) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
MAX_FILE_MB=10
POLL_INTERVAL_SECONDS=2

# --- engine limits (report §15: limit file size, sheet size, analysis duration) ---
MAX_CELLS=2000000
MAX_TABLE_ROWS=200000
ANALYSIS_TIMEOUT_SECONDS=120

# operational limits (Phase 8)
MAX_AUDIT_RETENTION_DAYS=180

# AI is optional. Leave AI_PROVIDER=none to use built-in logic only.
# To turn it on: AI_PROVIDER=gemini or groq, then fill in AI_API_KEY and AI_MODEL (see README, "Turning AI on").
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
